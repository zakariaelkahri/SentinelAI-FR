# SentinelAI Environment Variables

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sentinel

# Redis
REDIS_URL=redis://redis:6379/0

# Backend RAG (Qdrant + Ollama)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sentinelai-security-manual
QDRANT_API_KEY=
RAG_SOURCE_PATH=/workspace/data/processing/Guide-des-Protocoles.md
RAG_RETRIEVER_K=20
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_TOP_N=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_FORCE_REINDEX=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral-nemo
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=BAAI/bge-m3
RAG_CONTEXT_DOCS=3
RAG_MAX_CONTEXT_CHARS=8000
RAG_ASK_TIMEOUT_SECONDS=120
GEMINI_KEY=

# Backend Camera Streaming
RTSP_HOST_ALIAS=mediamtx
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|max_delay;500000|stimeout;5000000
MJPEG_FPS=10
MJPEG_JPEG_QUALITY=80
MJPEG_MAX_READ_FAILURES=40
MJPEG_RECONNECT_DELAY_SECONDS=0.25

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Airflow
AIRFLOW__CORE__FERNET_KEY=81HqDtbqAywKSOumSha3BhWNOdQ26slT6K0YaZeZyPs=
AIRFLOW__WEBSERVER__SECRET_KEY=sentinelai-secret-key

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Frontend
REACT_APP_API_URL=http://localhost:8000
